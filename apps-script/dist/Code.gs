  today: function () { return OSC.todayIST(Clock.nowMs()); }
};

function newId(prefix) {
  var u = Utilities.getUuid().replace(/-/g, '').slice(0, 12).toUpperCase();
  return (prefix || '') + u;
}

function bytesToB64(bytes) { return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/, ''); }
