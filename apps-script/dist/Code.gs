    var fb = lk ? finalBills(ym, deptCode).filter(function (b) { return b.companyId === companyId; })[0] : null;
    var m = model(c, companyId, { status: fb ? 'FINAL' : 'DRAFT', billNo: fb ? fb.billNo : '' });
