SCHEMA.EmailLog = { log: true, cols: [['at', 'datetime'], ['kind', 'str'], ['to', 'str'], ['subject', 'str'], ['status', 'str'], ['detail', 'str']] };
DEFAULT_SETTINGS.consoleUrl = ['', 'str', 'Console web address (GitHub Pages link) used for buttons in emails'];
