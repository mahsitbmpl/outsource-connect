/* ----- 03_settings_audit.js ----- */
/* ===== 03 Settings and Audit ===== */
var Settings = {
  raw: function (key) {
    var r = Db.find('Settings', key);
    if (r) return r.value;
    return DEFAULT_SETTINGS[key] ? DEFAULT_SETTINGS[key][0] : '';
  },
  str: function (key) { return String(Settings.raw(key)); },
  int: function (key) { var n = parseInt(Settings.raw(key), 10); return isNaN(n) ? parseInt(DEFAULT_SETTINGS[key][0], 10) : n; },
  num: function (key) { var n = parseFloat(Settings.raw(key)); return isNaN(n) ? parseFloat(DEFAULT_SETTINGS[key][0]) : n; },
  bool: function (key) { return String(Settings.raw(key)).toLowerCase() === 'true'; },
  list: function (key) { return toList(Settings.raw(key)); },

  /** Public view for the console (no secrets live in Settings). */
  allForUi: function () {
    var rows = Db.all('Settings'), map = {};
    Object.keys(DEFAULT_SETTINGS).forEach(function (k) {
      map[k] = { key: k, value: DEFAULT_SETTINGS[k][0], type: DEFAULT_SETTINGS[k][1], description: DEFAULT_SETTINGS[k][2] };
    });
    rows.forEach(function (r) { if (map[r.key]) { map[r.key].value = r.value; map[r.key].updatedAt = r.updatedAt; map[r.key].updatedBy = r.updatedBy; } });
    return Object.keys(map).map(function (k) { return map[k]; });
  },

  validateValue: function (key, value) {
    var def = DEFAULT_SETTINGS[key];
    if (!def) fail('VALIDATION', 'Unknown setting ' + key);
    var v = OSC.cleanText(value, 2000);
    switch (def[1]) {
      case 'int':
        if (!/^\d{1,6}$/.test(v)) failFields({ value: 'Enter a whole number' });
        break;
      case 'num':
        if (!/^\d{1,4}(\.\d{1,4})?$/.test(v)) failFields({ value: 'Enter a number, for example 0.45' });
        break;
      case 'bool':
        v = v.toLowerCase();
        if (v !== 'true' && v !== 'false') failFields({ value: 'Enter true or false' });
        break;
      case 'str':
        if (key === 'consoleUrl' && v && !/^https:\/\/[^\s"'<>]+$/.test(v)) failFields({ value: 'Use the full https:// address of the console' });
        break;
      case 'weekday':
        v = v.slice(0, 1).toUpperCase() + v.slice(1, 3).toLowerCase();
        if (['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(v) < 0) failFields({ value: 'Enter Mon, Tue, Wed, Thu, Fri, Sat or Sun' });
        break;
      case 'time':
        if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(v)) failFields({ value: 'Use 24-hour HH:MM, for example 09:00' });
        break;
      case 'list':
        v = toList(v).join(',');
        if (/^email/.test(key)) {
          var bad = toList(v).filter(function (x) { return !OSC.isEmail(x); });
          if (bad.length) failFields({ value: 'Not a valid email: ' + bad.join(', ') });
        }
        if ((key === 'titles' || key === 'designations') && !v) failFields({ value: 'The list cannot be empty' });
        break;
    }
    return v;
  },

  update: function (user, key, value, reason) {
    var v = Settings.validateValue(key, value);
    if (key === 'designations') {
      var used = {}; Db.all('Staff').forEach(function (s) { used[s.designation] = 1; });
      var missing = Object.keys(used).filter(function (d) { return toList(v).indexOf(d) < 0; });
      if (missing.length) failFields({ value: 'Designation in use by staff, cannot remove: ' + missing.join(', ') });
    }
    return withLock(function () {
      var cur = Db.find('Settings', key);
      var now = Clock.now();
      if (cur) {
        var ch = Db.update('Settings', key, { value: v, updatedAt: now, updatedBy: user.username });
        Audit.log(user, 'settings.update', 'Settings', key, reason, { value: ch.before.value }, { value: v });
      } else {
        Db.insert('Settings', { key: key, value: v, type: DEFAULT_SETTINGS[key][1], description: DEFAULT_SETTINGS[key][2], updatedAt: now, updatedBy: user.username });
        Audit.log(user, 'settings.update', 'Settings', key, reason, null, { value: v });
      }
      return { key: key, value: v };
    });
  }
};

var Audit = {
  log: function (user, action, entity, entityId, reason, before, after) {
    Db.append('AuditLog', {
      auditId: newId('AU'), at: Clock.now(), username: user ? user.username : 'system',
      action: action, entity: entity, entityId: entityId || '', reason: reason || '',
      before: before == null ? '' : before, after: after == null ? '' : after
    });
  },
  recent: function (limit, filter) {
    var rows = Db.tail('AuditLog', Math.min(Math.max(limit || 200, 1), 1000));
    if (filter && filter.entity) rows = rows.filter(function (r) { return r.entity === filter.entity; });
    if (filter && filter.entityId) rows = rows.filter(function (r) { return r.entityId === filter.entityId; });
    return rows.map(function (r) { delete r._row; return r; });
  }
};

function requireReason(reason) {
  var r = OSC.cleanText(reason, 300);
  if (r.length < 3) failFields({ reason: 'Enter a reason (at least 3 characters)' });
  return r;
}


/* ----- 04_auth.js ----- */
/* ===== 04 Auth: passwords, sessions, users ===== */
var Auth = (function () {

  // ----- PBKDF2-HMAC-SHA256 (single 32-byte block) -----
  function strBytes(s) { return Utilities.newBlob(String(s)).getBytes(); }
  /** PBKDF2-HMAC-SHA256 (plain JavaScript, see FastHash). Returns signed bytes like Utilities does. */
  function pbkdf2(password, saltBytes, iterations) {
    var out = FastHash.pbkdf2(strBytes(password).map(function (b) { return b & 0xff; }), saltBytes.map(function (b) { return b & 0xff; }), iterations);
    return Array.prototype.map.call(out, function (b) { return b > 127 ? b - 256 : b; });
  }
  function hashPassword(password, iterations) {
    iterations = iterations || PBKDF2_ITERATIONS;
    var salt = randomBytes(16);
    return 'pbkdf2-sha256$' + iterations + '$' + bytesToB64(salt) + '$' + bytesToB64(pbkdf2(password, salt, iterations));
  }
  function verifyPassword(password, stored) {
    var p = String(stored || '').split('$');
    if (p.length !== 4 || p[0] !== 'pbkdf2-sha256') return false;
    var got = bytesToB64(pbkdf2(password, b64ToBytes(p[2]), parseInt(p[1], 10)));
    var want = p[3], diff = got.length ^ want.length;
    for (var i = 0; i < Math.min(got.length, want.length); i++) diff |= got.charCodeAt(i) ^ want.charCodeAt(i);
    return diff === 0;
  }
  /** Readable temporary password, e.g. 'Kite-4827-Rams' (14 chars, letters and digits). */
  function tempPassword() {
    var words = ['Kite', 'Lamp', 'Rose', 'Mint', 'Ruby', 'Jade', 'Neem', 'Tulsi', 'Lotus', 'Mango', 'Pearl', 'River', 'Cedar', 'Amber', 'Coral', 'Sagar'];
    var b = randomBytes(6);
    var n = ((b[0] & 0xff) * 256 + (b[1] & 0xff)) % 9000 + 1000;
    return words[(b[2] & 0xff) % words.length] + '-' + n + '-' + words[(b[3] & 0xff) % words.length] + ((b[4] & 0xff) % 10);
  }

  // ----- sessions -----
  function cache() { return CacheService.getScriptCache(); }
  function publicUser(u) { return { username: u.username, fullName: u.fullName, role: u.role, mustChange: !!u.mustChange }; }

  function login(username, password, userAgent) {
    username = OSC.cleanText(username).toLowerCase();
    var ua = clip(userAgent || '', 200);
    if (!username || !password) fail('AUTH', 'Enter username and password');
    return withLock(function () {
      var u = Db.find('Users', username);
      if (!u || !u.active) {
        Db.append('LoginLog', { at: Clock.now(), username: username, result: 'FAIL', detail: u ? 'disabled' : 'unknown user', userAgent: ua });
        fail('AUTH', 'Wrong username or password');
      }
      if (u.lockedUntil && !isPast(u.lockedUntil)) {
        Db.append('LoginLog', { at: Clock.now(), username: username, result: 'LOCKED', detail: 'until ' + u.lockedUntil, userAgent: ua });
        fail('LOCKED', 'Account locked after too many wrong passwords. Try again after ' + OSC.fmtDateTime(u.lockedUntil) + ' or ask the Admin to unlock it.');
      }
      if (!verifyPassword(password, u.pwHash)) {
        var count = (u.failedCount || 0) + 1, patch = { failedCount: count };
        var limit = Settings.int('lockoutAttempts');
        if (count >= limit) { patch.lockedUntil = isoPlusMinutes(Settings.int('lockoutMinutes')); patch.failedCount = 0; }
        Db.update('Users', username, patch);
        Db.append('LoginLog', { at: Clock.now(), username: username, result: patch.lockedUntil ? 'LOCKED' : 'FAIL', detail: 'wrong password ' + count + '/' + limit, userAgent: ua });
        if (patch.lockedUntil) fail('LOCKED', 'Too many wrong passwords. The account is locked for ' + Settings.int('lockoutMinutes') + ' minutes.');
        fail('AUTH', 'Wrong username or password');
      }
      var okPatch = { failedCount: 0, lockedUntil: '', lastLoginAt: Clock.now() };
      if (String(u.pwHash).split('$')[1] !== String(PBKDF2_ITERATIONS)) okPatch.pwHash = hashPassword(password); // upgrade/downgrade rounds
      Db.update('Users', username, okPatch);
      var token = bytesToB64(randomBytes(32));
      var sid = sha256Hex(token);
      var sess = { sid: sid, username: username, createdAt: Clock.now(), expiresAt: isoPlusMinutes(Settings.int('sessionHours') * 60), lastSeenAt: Clock.now(), revoked: false, userAgent: ua };
      Db.insert('Sessions', sess);
      putCache(sess);
      Db.append('LoginLog', { at: Clock.now(), username: username, result: 'OK', detail: '', userAgent: ua });
      return { token: token, user: publicUser(u), expiresAt: sess.expiresAt };
    });
  }
  function putCache(sess) {
    try { cache().put('sess:' + sess.sid, JSON.stringify({ username: sess.username, expiresAt: sess.expiresAt, lastSeenAt: sess.lastSeenAt, revoked: !!sess.revoked }), 21600); } catch (e) { /* ignore */ }
  }

  /** Returns the user for a token or throws AUTH. Updates idle timer. */
  function check(token) {
    if (!token || typeof token !== 'string' || token.length < 20) fail('AUTH', 'Please sign in');
    var sid = sha256Hex(token);
    var c = cache().get('sess:' + sid), s;
    if (c) s = JSON.parse(c);
    else {
      var row = Db.find('Sessions', sid);
      if (!row) fail('AUTH', 'Please sign in');
      s = { username: row.username, expiresAt: row.expiresAt, lastSeenAt: row.lastSeenAt, revoked: row.revoked };
    }
    if (s.revoked) fail('AUTH', 'You have been signed out. Please sign in again.');
    if (isPast(s.expiresAt)) fail('AUTH', 'Your session has ended. Please sign in again.');
    var idleMs = Settings.int('sessionIdleMinutes') * 60000;
    if (Clock.nowMs() - Date.parse(s.lastSeenAt) > idleMs) fail('AUTH', 'Signed out after ' + Settings.int('sessionIdleMinutes') + ' idle minutes. Please sign in again.');
    var u = Db.find('Users', s.username);
    if (!u || !u.active) fail('AUTH', 'Your account is disabled');
    var nowMs = Clock.nowMs(), prev = Date.parse(s.lastSeenAt);
    s.lastSeenAt = Clock.now();
    s.sid = sid;
    putCache(s);
    if (nowMs - prev > 5 * 60000) { try { Db.update('Sessions', sid, { lastSeenAt: s.lastSeenAt }); } catch (e) { /* row may be missing */ } }
    return { username: u.username, fullName: u.fullName, role: u.role, mustChange: !!u.mustChange, sid: sid };
  }

  function logout(user) {
    withLock(function () {
      Db.update('Sessions', user.sid, { revoked: true });
      try { cache().remove('sess:' + user.sid); } catch (e) { /* ignore */ }
    });
    return { done: true };
  }
  function revokeAll(username) {
    Db.where('Sessions', function (s) { return s.username === username && !s.revoked; }).forEach(function (s) {
      Db.update('Sessions', s.sid, { revoked: true });
      try { cache().remove('sess:' + s.sid); } catch (e) { /* ignore */ }
    });
  }

  function changePassword(user, oldPw, newPw) {
    var u = Db.find('Users', user.username);
    if (!verifyPassword(oldPw || '', u.pwHash)) failFields({ oldPassword: 'Current password is wrong' });
    var probs = OSC.validatePassword(newPw, u.username, Settings.int('passwordMinLength'));
    if (probs.length) failFields({ newPassword: 'Password needs ' + probs.join(', ') });
    if (verifyPassword(newPw, u.pwHash)) failFields({ newPassword: 'Choose a password different from the current one' });
    withLock(function () {
      Db.update('Users', u.username, { pwHash: hashPassword(newPw), mustChange: false, pwChangedAt: Clock.now(), updatedAt: Clock.now(), updatedBy: u.username });
    });
    Audit.log(user, 'auth.changePassword', 'Users', u.username, '', null, null);
    return { done: true };
  }

  // ----- user admin -----
  function listUsers() {
    return Db.all('Users').map(function (u) {
      return { username: u.username, fullName: u.fullName, role: u.role, active: u.active, mustChange: u.mustChange,
        locked: !!(u.lockedUntil && !isPast(u.lockedUntil)), lastLoginAt: u.lastLoginAt, createdAt: u.createdAt, createdBy: u.createdBy };
    });
  }
  function createUser(admin, data) {
    var e = {};
    var username = OSC.cleanText(data.username).toLowerCase();
    var fullName = OSC.cleanText(data.fullName, 60);
    var role = data.role === APP.roles.ADMIN ? APP.roles.ADMIN : APP.roles.OPS;
    if (!OSC.isUsername(username)) e.username = '4 to 30 characters: small letters, digits, dot or underscore, starting with a letter';
    if (!OSC.isName(fullName)) e.fullName = 'Enter the full name';
    if (Object.keys(e).length) failFields(e);
    var temp = tempPassword();
    withLock(function () {
      if (Db.find('Users', username)) failFields({ username: 'This username already exists' });
      Db.insert('Users', { username: username, fullName: fullName, role: role, active: true, pwHash: hashPassword(temp), mustChange: true, failedCount: 0, createdAt: Clock.now(), createdBy: admin.username, updatedAt: Clock.now(), updatedBy: admin.username });
    });
    Audit.log(admin, 'users.create', 'Users', username, '', null, { fullName: fullName, role: role });
    return { username: username, tempPassword: temp };
  }
  function setActive(admin, username, active, reason) {
    reason = requireReason(reason);
    if (username === admin.username && !active) fail('VALIDATION', 'You cannot disable your own account');
    var u = Db.find('Users', username);
    if (!u) fail('NOT_FOUND', 'User not found');
    if (!active && u.role === APP.roles.ADMIN) {
      var admins = Db.where('Users', function (x) { return x.role === APP.roles.ADMIN && x.active; });
      if (admins.length <= 1) fail('VALIDATION', 'At least one active Admin is required');
    }
    withLock(function () {
      Db.update('Users', username, { active: !!active, updatedAt: Clock.now(), updatedBy: admin.username });
      if (!active) revokeAll(username);
    });
    Audit.log(admin, active ? 'users.enable' : 'users.disable', 'Users', username, reason, { active: u.active }, { active: !!active });
    return { done: true };
  }
  function resetPassword(admin, username, reason) {
    reason = requireReason(reason);
    var u = Db.find('Users', username);
    if (!u) fail('NOT_FOUND', 'User not found');
    var temp = tempPassword();
    withLock(function () {
      Db.update('Users', username, { pwHash: hashPassword(temp), mustChange: true, failedCount: 0, lockedUntil: '', updatedAt: Clock.now(), updatedBy: admin.username });
      revokeAll(username);
    });
    Audit.log(admin, 'users.resetPassword', 'Users', username, reason, null, null);
    return { username: username, tempPassword: temp };
  }
  function loginLog(limit) {
    return Db.tail('LoginLog', Math.min(limit || 200, 1000)).map(function (r) { delete r._row; return r; });
  }

  return {
    pbkdf2: pbkdf2, hashPassword: hashPassword, verifyPassword: verifyPassword, tempPassword: tempPassword,
    login: login, check: check, logout: logout, changePassword: changePassword, revokeAll: revokeAll,
    listUsers: listUsers, createUser: createUser, setActive: setActive, resetPassword: resetPassword, loginLog: loginLog,
    publicUser: publicUser
  };
})();


/* ----- 05_masters.js ----- */
/* ===== 05 Masters: departments, companies, rate cards, month locks ===== */
var Departments = {
  list: function () {
    return Db.all('Departments').slice().sort(function (a, b) { return (a.sortOrder || 99) - (b.sortOrder || 99); })
      .map(function (d) { return { code: d.code, name: d.name, active: d.active, nextSeq: d.nextSeq, reqDay: d.reqDay, reqNight: d.reqNight, sortOrder: d.sortOrder }; });
  },
  get: function (code) { return Db.find('Departments', code); },
  save: function (admin, data, reason) {
    var e = {}, code = OSC.cleanText(data.code).toUpperCase();
    var name = OSC.cleanText(data.name, 60);
    var reqDay = Number(data.reqDay), reqNight = Number(data.reqNight);
    if (!/^[A-Z]{2,4}$/.test(code)) e.code = '2 to 4 capital letters, for example HK';
    if (name.length < 2) e.name = 'Enter the department name';
    if (!(reqDay >= 0 && reqDay <= 500 && Math.floor(reqDay) === reqDay)) e.reqDay = 'Whole number';
    if (!(reqNight >= 0 && reqNight <= 500 && Math.floor(reqNight) === reqNight)) e.reqNight = 'Whole number';
    if (Object.keys(e).length) failFields(e);
    return withLock(function () {
      var cur = Db.find('Departments', code), now = Clock.now();
      if (cur) {
        reason = requireReason(reason);
        if (data.active === false || data.active === 'false') {
          var active = Db.where('Staff', function (s) { return s.deptCode === code && s.status === 'Active'; });
          if (active.length) failFields({ active: active.length + ' active staff are in this department. Move or exit them first.' });
        }
        var ch = Db.update('Departments', code, { name: name, reqDay: reqDay, reqNight: reqNight, active: !(data.active === false || data.active === 'false'), sortOrder: Number(data.sortOrder) || cur.sortOrder, updatedAt: now, updatedBy: admin.username });
        Audit.log(admin, 'departments.update', 'Departments', code, reason, ch.before, ch.after);
        return ch.after;
      }
      var rec = { code: code, name: name, active: true, nextSeq: 1, reqDay: reqDay, reqNight: reqNight, sortOrder: Number(data.sortOrder) || Db.all('Departments').length + 1, updatedAt: now, updatedBy: admin.username };
      Db.insert('Departments', rec);
      Audit.log(admin, 'departments.create', 'Departments', code, reason || '', null, rec);
      return rec;
    });
  }
};

var Companies = {
  toPublic: function (c) {
    return { companyId: c.companyId, code: c.code, name: c.name, deptCodes: toList(c.deptCodes), contractStart: c.contractStart, contractEnd: c.contractEnd,
      status: c.status, gstin: c.gstin, pan: c.pan, address: c.address, contactName: c.contactName, contactMobile: c.contactMobile,
      contactEmail: c.contactEmail, notes: c.notes, createdAt: c.createdAt, createdBy: c.createdBy, updatedAt: c.updatedAt, updatedBy: c.updatedBy };
  },
  list: function () { return Db.all('Companies').map(Companies.toPublic); },
  get: function (id) { var c = Db.find('Companies', id); return c ? Companies.toPublic(c) : null; },
  save: function (user, data, reason) {
    var isNew = !data.companyId;
    var codes = {}; Db.all('Companies').forEach(function (c) { codes[c.code] = c.companyId; });
    var r = OSC.validateCompany(data, { today: Clock.today(), departments: Db.all('Departments'), existingCodes: codes, selfId: data.companyId || null });
    if (!r.ok) failFields(r.errors);
    var v = r.value; v.deptCodes = v.deptCodes.join(',');
    return withLock(function () {
      var now = Clock.now();
      if (isNew) {
        var n = Db.all('Companies').length + 1, id;
        do { id = 'CO' + OSC.pad(n++, 3); } while (Db.find('Companies', id));
        v.companyId = id; v.createdAt = now; v.createdBy = user.username; v.updatedAt = now; v.updatedBy = user.username;
        Db.insert('Companies', v);
        Audit.log(user, 'companies.create', 'Companies', id, reason || '', null, v);
        return Companies.get(id);
      }
      reason = requireReason(reason);
      var cur = Db.find('Companies', data.companyId);
      if (!cur) fail('NOT_FOUND', 'Company not found');
      var removed = toList(cur.deptCodes).filter(function (d) { return toList(v.deptCodes).indexOf(d) < 0; });
      if (removed.length) {
        var inUse = Db.where('Staff', function (s) { return s.companyId === cur.companyId && s.status === 'Active' && removed.indexOf(s.deptCode) >= 0; });
        if (inUse.length) failFields({ deptCodes: inUse.length + ' active staff of this company are in ' + removed.join(', ') + '. Transfer them first.' });
      }
      if (v.status === 'Inactive') {
        var act = Db.where('Staff', function (s) { return s.companyId === cur.companyId && s.status === 'Active'; });
        if (act.length) failFields({ status: act.length + ' active staff belong to this company. Transfer or exit them first.' });
      }
      v.updatedAt = now; v.updatedBy = user.username;
      var ch = Db.update('Companies', cur.companyId, v);
      Audit.log(user, 'companies.update', 'Companies', cur.companyId, reason, ch.before, ch.after);
      return Companies.get(cur.companyId);
    });
  }
};

var Rates = {
  toPublic: function (r) {
    return { rateId: r.rateId, companyId: r.companyId, deptCode: r.deptCode, designation: r.designation, ratePerDuty: r.ratePerDuty, gstPct: r.gstPct,
      effectiveFrom: r.effectiveFrom, effectiveTo: r.effectiveTo, status: r.status, note: r.note, createdAt: r.createdAt, createdBy: r.createdBy, voidReason: r.voidReason };
  },
  list: function (companyId) {
    return Db.where('Rates', function (r) { return !companyId || r.companyId === companyId; })
      .sort(function (a, b) { return (a.deptCode + a.designation + a.effectiveFrom) < (b.deptCode + b.designation + b.effectiveFrom) ? -1 : 1; })
      .map(Rates.toPublic);
  },
  /** Rate card in force for company/department/designation on a date, or null. */
  rateFor: function (companyId, deptCode, designation, isoDate) {
    var hits = Db.where('Rates', function (r) {
      return r.status === 'Active' && r.companyId === companyId && r.deptCode === deptCode && r.designation === designation &&
        r.effectiveFrom <= isoDate && (!r.effectiveTo || r.effectiveTo >= isoDate);
    });
    hits.sort(function (a, b) { return a.effectiveFrom < b.effectiveFrom ? 1 : -1; });
    return hits[0] ? Rates.toPublic(hits[0]) : null;
  },
  /**
   * Adds a rate card. The previous open card for the same company/department/designation is closed the day before.
   * Rates can never start inside a locked month, so past bills never change.
   */
  add: function (user, data) {
    var company = Db.find('Companies', data.companyId);
    if (!company) fail('NOT_FOUND', 'Company not found');
    var r = OSC.validateRate(data, { company: { deptCodes: toList(company.deptCodes) }, designations: Settings.list('designations') });
    if (!r.ok) failFields(r.errors);
    var v = r.value;
    if (MonthLocks.isLocked(v.deptCode, OSC.monthOf(v.effectiveFrom))) failFields({ effectiveFrom: OSC.fmtMonth(OSC.monthOf(v.effectiveFrom)) + ' is locked for this department. Choose a date in an open month.' });
    return withLock(function () {
      var same = Db.where('Rates', function (x) { return x.status === 'Active' && x.companyId === company.companyId && x.deptCode === v.deptCode && x.designation === v.designation; });
      var later = same.filter(function (x) { return x.effectiveFrom >= v.effectiveFrom; });
      if (later.length) failFields({ effectiveFrom: 'A rate already starts on ' + OSC.fmtDate(later[0].effectiveFrom) + '. New rates must start after the latest one.' });
      var now = Clock.now();
      same.forEach(function (x) {
        if (!x.effectiveTo || x.effectiveTo >= v.effectiveFrom) {
          var ch = Db.update('Rates', x.rateId, { effectiveTo: OSC.addDays(v.effectiveFrom, -1) });
          Audit.log(user, 'rates.autoClose', 'Rates', x.rateId, 'New rate from ' + v.effectiveFrom, { effectiveTo: ch.before.effectiveTo }, { effectiveTo: ch.after.effectiveTo });
        }
      });
      var rec = { rateId: newId('RT'), companyId: company.companyId, deptCode: v.deptCode, designation: v.designation, ratePerDuty: v.ratePerDuty, gstPct: v.gstPct,
        effectiveFrom: v.effectiveFrom, effectiveTo: v.effectiveTo || '', status: 'Active', note: v.note, createdAt: now, createdBy: user.username, voidReason: '' };
      Db.insert('Rates', rec);
      Audit.log(user, 'rates.add', 'Rates', rec.rateId, v.note, null, rec);
      return Rates.toPublic(rec);
    });
  },
  /** Cancels a wrongly entered card. Not allowed if it touches a locked month. */
  voidRate: function (user, rateId, reason) {
    reason = requireReason(reason);
    var cur = Db.find('Rates', rateId);
    if (!cur) fail('NOT_FOUND', 'Rate not found');
    if (cur.status !== 'Active') fail('VALIDATION', 'This rate is already cancelled');
    if (MonthLocks.anyLockedBetween(cur.deptCode, cur.effectiveFrom, cur.effectiveTo || '9999-12-31')) fail('VALIDATION', 'This rate was used in a locked month and cannot be cancelled. Add a new rate instead.');
    return withLock(function () {
      var ch = Db.update('Rates', rateId, { status: 'Void', voidReason: reason });
      Audit.log(user, 'rates.void', 'Rates', rateId, reason, ch.before, ch.after);
      return Rates.toPublic(ch.after);
    });
  }
};

/* Month locks are created in Phase 5; Phase 1 only reads them so rates and transfers respect locked months. */
var MonthLocks = {
  isLocked: function (deptCode, ym) {
    return Db.where('MonthLocks', function (m) { return m.month === ym && (m.deptCode === deptCode || m.deptCode === 'ALL') && m.status === 'LOCKED'; }).length > 0;
  },
  anyLockedBetween: function (deptCode, fromIso, toIso) {
    var a = OSC.monthOf(fromIso), b = OSC.monthOf(toIso);
    return Db.where('MonthLocks', function (m) { return m.status === 'LOCKED' && (m.deptCode === deptCode || m.deptCode === 'ALL') && m.month >= a && m.month <= b; }).length > 0;
  }
};


/* ----- 06_staff.js ----- */
/* ===== 06 Staff master, history, transfers, exits, bulk import ===== */
var FACE = { NONE: 'Not enrolled', PENDING: 'Pending', ACTIVE: 'Active', DISABLED: 'Disabled' };
var HIST_FIELDS = ['department', 'company', 'designation'];

var Staff = (function () {
  function deptMap() { var m = {}; Db.all('Departments').forEach(function (d) { m[d.code] = d; }); return m; }
  function coMap() { var m = {}; Db.all('Companies').forEach(function (c) { m[c.companyId] = c; }); return m; }

  function toPublic(s, dm, cm) {
    dm = dm || deptMap(); cm = cm || coMap();
    return {
      staffId: s.staffId, title: s.title, fullName: s.fullName, displayName: s.title + ' ' + s.fullName,
      dob: s.dob, age: OSC.ageOn(s.dob, Clock.today()), mobile: s.mobile,
      deptCode: s.deptCode, deptName: dm[s.deptCode] ? dm[s.deptCode].name : s.deptCode,
      designation: s.designation, companyId: s.companyId, companyName: cm[s.companyId] ? cm[s.companyId].name : s.companyId,
      companyCode: cm[s.companyId] ? cm[s.companyId].code : '',
      joinDate: s.joinDate, exitDate: s.exitDate, exitReason: s.exitReason, status: s.status, faceStatus: s.faceStatus,
      vendorCode: s.vendorCode, createdAt: s.createdAt, createdBy: s.createdBy, updatedAt: s.updatedAt, updatedBy: s.updatedBy
    };
  }
  function context(selfId, isNew) {
    var mobiles = {};
    Db.all('Staff').forEach(function (s) { if (s.status === 'Active') mobiles[s.mobile] = s.staffId; });
    return {
      today: Clock.today(), titles: Settings.list('titles'), designations: Settings.list('designations'),
      departments: Db.all('Departments'), companies: Companies.list(), activeMobiles: mobiles, selfId: selfId || null, isNew: !!isNew
    };
  }
  function assertOpenMonth(deptCode, iso, field) {
    if (MonthLocks.isLocked(deptCode, OSC.monthOf(iso))) {
      var f = {}; f[field] = OSC.fmtMonth(OSC.monthOf(iso)) + ' is locked. Choose a date in an open month.'; failFields(f);
    }
  }
  function addHistory(user, staffId, field, value, from, reason) {
    Db.insert('StaffHistory', { histId: newId('SH'), staffId: staffId, field: field, value: value, effectiveFrom: from, effectiveTo: '', reason: reason || '', createdAt: Clock.now(), createdBy: user.username });
  }
  function openHistory(staffId, field) {
    return Db.where('StaffHistory', function (h) { return h.staffId === staffId && h.field === field && !h.effectiveTo; })[0] || null;
  }
  /** Close the open row of a field the day before `from` and open a new one. */
  function changeHistory(user, staffId, field, value, from, reason) {
    var open = openHistory(staffId, field);
    if (open) {
      if (open.effectiveFrom >= from) {
        var f = {}; f.effectiveFrom = 'Must be after ' + OSC.fmtDate(open.effectiveFrom) + ', when the current ' + field + ' started'; failFields(f);
      }
      Db.update('StaffHistory', open.histId, { effectiveTo: OSC.addDays(from, -1) });
    }
    addHistory(user, staffId, field, value, from, reason);
  }

  /** Must be called inside withLock. v = validated value from OSC.validateStaff. */
  function createLocked(user, v, source) {
    var dept = Db.find('Departments', v.deptCode);
    var seq = dept.nextSeq || 1, id = OSC.staffId(dept.code, seq);
    while (Db.find('Staff', id)) { seq++; id = OSC.staffId(dept.code, seq); }
    var now = Clock.now();
    var rec = { staffId: id, title: v.title, fullName: v.fullName, dob: v.dob, mobile: v.mobile, deptCode: v.deptCode, designation: v.designation,
      companyId: v.companyId, joinDate: v.joinDate, exitDate: '', exitReason: '', status: 'Active', faceStatus: FACE.NONE, vendorCode: v.vendorCode,
      createdAt: now, createdBy: user.username, updatedAt: now, updatedBy: user.username };
    Db.insert('Staff', rec);
    Db.update('Departments', dept.code, { nextSeq: seq + 1 });
    addHistory(user, id, 'department', v.deptCode, v.joinDate, 'Joined');
    addHistory(user, id, 'company', v.companyId, v.joinDate, 'Joined');
    addHistory(user, id, 'designation', v.designation, v.joinDate, 'Joined');
    Audit.log(user, 'staff.create', 'Staff', id, source || '', null, rec);
    return rec;
  }

  function list(filter) {
    var dm = deptMap(), cm = coMap();
    return Db.all('Staff').filter(function (s) {
      if (filter && filter.status && filter.status !== 'All' && s.status !== filter.status) return false;
      return true;
    }).map(function (s) { return toPublic(s, dm, cm); });
  }
  function get(staffId) {
    var s = Db.find('Staff', staffId);
    if (!s) fail('NOT_FOUND', 'Staff ' + staffId + ' not found');
    var hist = Db.where('StaffHistory', function (h) { return h.staffId === staffId; })
      .sort(function (a, b) { return a.effectiveFrom < b.effectiveFrom ? -1 : 1; })
      .map(function (h) { delete h._row; return h; });
    var p = toPublic(s);
    p.history = hist;
    p.currentRate = Rates.rateFor(s.companyId, s.deptCode, s.designation, Clock.today());
    return p;
  }
  function create(user, data) {
    var r = OSC.validateStaff(data, context(null, true));
    if (!r.ok) failFields(r.errors);
    return withLock(function () { return toPublic(createLocked(user, r.value, 'Added in console')); });
  }
  function update(user, staffId, data, reason) {
    reason = requireReason(reason);
    var cur = Db.find('Staff', staffId);
    if (!cur) fail('NOT_FOUND', 'Staff not found');
    var merged = {
      title: data.title, fullName: data.fullName, dob: data.dob, mobile: data.mobile, designation: data.designation || cur.designation,
      joinDate: data.joinDate || cur.joinDate, vendorCode: data.vendorCode
    };
    var ctx = context(staffId, false);
    if (cur.status !== 'Active') ctx.activeMobiles = {}; // exited staff may share a number with a new joiner
    var r = OSC.validateStaff(merged, ctx);
    if (!r.ok) failFields(r.errors);
    var v = r.value;
    return withLock(function () {
      var patch = { title: v.title, fullName: v.fullName, dob: v.dob, mobile: v.mobile, vendorCode: v.vendorCode, updatedAt: Clock.now(), updatedBy: user.username };
      if (v.joinDate !== cur.joinDate) {
        assertOpenMonth(cur.deptCode, v.joinDate < cur.joinDate ? v.joinDate : cur.joinDate, 'joinDate');
        patch.joinDate = v.joinDate;
        Db.where('StaffHistory', function (h) { return h.staffId === staffId && h.effectiveFrom === cur.joinDate; })
          .forEach(function (h) { Db.update('StaffHistory', h.histId, { effectiveFrom: v.joinDate }); });
      }
      if (v.designation !== cur.designation) {
        var from = OSC.parseDate(data.designationFrom) || Clock.today();
        assertOpenMonth(cur.deptCode, from, 'designationFrom');
        changeHistory(user, staffId, 'designation', v.designation, from, reason);
        patch.designation = v.designation;
      }
      var ch = Db.update('Staff', staffId, patch);
      Audit.log(user, 'staff.update', 'Staff', staffId, reason, ch.before, ch.after);
      return toPublic(ch.after);
    });
  }
  /** Move to another department and/or company. Employee ID never changes. */
  function transfer(user, staffId, data) {
    var reason = requireReason(data.reason);
    var cur = Db.find('Staff', staffId);
    if (!cur) fail('NOT_FOUND', 'Staff not found');
    if (cur.status !== 'Active') fail('VALIDATION', 'Only active staff can be transferred');
    var e = {};
    var deptCode = OSC.cleanText(data.deptCode || cur.deptCode).toUpperCase();
    var companyId = OSC.cleanText(data.companyId || cur.companyId);
    var from = OSC.parseDate(data.effectiveFrom);
    var dept = Db.find('Departments', deptCode), co = Db.find('Companies', companyId);
    if (!dept || !dept.active) e.deptCode = 'Choose an active department';
    if (!co || co.status !== 'Active') e.companyId = 'Choose an active company';
    else if (dept && toList(co.deptCodes).indexOf(deptCode) < 0) e.companyId = co.name + ' does not serve ' + dept.name;
    if (!from) e.effectiveFrom = 'Enter the date the change starts';
    else if (from <= cur.joinDate) e.effectiveFrom = 'Must be after the joining date';
    else if (from > Clock.today()) e.effectiveFrom = 'Cannot be a future date';
    if (deptCode === cur.deptCode && companyId === cur.companyId) e.deptCode = 'Nothing changed';
    if (Object.keys(e).length) failFields(e);
    assertOpenMonth(cur.deptCode, from, 'effectiveFrom');
    assertOpenMonth(deptCode, from, 'effectiveFrom');
    return withLock(function () {
      if (deptCode !== cur.deptCode) changeHistory(user, staffId, 'department', deptCode, from, reason);
      if (companyId !== cur.companyId) changeHistory(user, staffId, 'company', companyId, from, reason);
      var ch = Db.update('Staff', staffId, { deptCode: deptCode, companyId: companyId, updatedAt: Clock.now(), updatedBy: user.username });
      Audit.log(user, 'staff.transfer', 'Staff', staffId, reason, { deptCode: cur.deptCode, companyId: cur.companyId }, { deptCode: deptCode, companyId: companyId, effectiveFrom: from });
      return toPublic(ch.after);
    });
  }
  function exit(user, staffId, data) {
    var cur = Db.find('Staff', staffId);
    if (!cur) fail('NOT_FOUND', 'Staff not found');
    if (cur.status !== 'Active') fail('VALIDATION', 'This person has already exited');
    var reason = OSC.cleanText(data.exitReason, 200), e = {};
    var d = OSC.parseDate(data.exitDate);
    if (!d) e.exitDate = 'Enter the last working date';
    else if (d < cur.joinDate) e.exitDate = 'Cannot be before the joining date';
    else if (d > OSC.addDays(Clock.today(), 31)) e.exitDate = 'Cannot be more than 31 days ahead';
    if (reason.length < 3) e.exitReason = 'Enter the reason for exit';
    if (Object.keys(e).length) failFields(e);
    assertOpenMonth(cur.deptCode, d, 'exitDate');
    return withLock(function () {
      HIST_FIELDS.forEach(function (f) { var o = openHistory(staffId, f); if (o) Db.update('StaffHistory', o.histId, { effectiveTo: d }); });
      var ch = Db.update('Staff', staffId, { status: 'Exited', exitDate: d, exitReason: reason,
        faceStatus: cur.faceStatus === FACE.NONE ? FACE.NONE : FACE.DISABLED, updatedAt: Clock.now(), updatedBy: user.username });
      Audit.log(user, 'staff.exit', 'Staff', staffId, reason, { status: cur.status }, { status: 'Exited', exitDate: d });
      return toPublic(ch.after);
    });
  }
  function reactivate(user, staffId, data) {
    var reason = requireReason(data.reason);
    var cur = Db.find('Staff', staffId);
    if (!cur) fail('NOT_FOUND', 'Staff not found');
    if (cur.status === 'Active') fail('VALIDATION', 'Already active');
    var d = OSC.parseDate(data.rejoinDate), e = {};
    if (!d) e.rejoinDate = 'Enter the re-joining date';
    else if (cur.exitDate && d <= cur.exitDate) e.rejoinDate = 'Must be after the exit date ' + OSC.fmtDate(cur.exitDate);
    var clash = Db.where('Staff', function (s) { return s.status === 'Active' && s.mobile === cur.mobile; })[0];
    if (clash) e.rejoinDate = 'Mobile ' + cur.mobile + ' is now used by ' + clash.staffId + '. Update the mobile first.';
    var dept = Db.find('Departments', cur.deptCode), co = Db.find('Companies', cur.companyId);
    if (!dept || !dept.active || !co || co.status !== 'Active') e.rejoinDate = 'Department or company is inactive. Re-join is not possible with the old details.';
    if (Object.keys(e).length) failFields(e);
    assertOpenMonth(cur.deptCode, d, 'rejoinDate');
    return withLock(function () {
      addHistory(user, staffId, 'department', cur.deptCode, d, 'Re-joined');
      addHistory(user, staffId, 'company', cur.companyId, d, 'Re-joined');
      addHistory(user, staffId, 'designation', cur.designation, d, 'Re-joined');
      var ch = Db.update('Staff', staffId, { status: 'Active', exitDate: '', exitReason: '', faceStatus: FACE.NONE, updatedAt: Clock.now(), updatedBy: user.username });
      Audit.log(user, 'staff.reactivate', 'Staff', staffId, reason, { status: cur.status, exitDate: cur.exitDate }, { status: 'Active', rejoinDate: d });
      return toPublic(ch.after);
    });
  }
  /** Value of department/company/designation for a staff member on a date (used by later phases). */
  function valueOn(staffId, field, isoDate) {
    var h = Db.where('StaffHistory', function (x) { return x.staffId === staffId && x.field === field && x.effectiveFrom <= isoDate && (!x.effectiveTo || x.effectiveTo >= isoDate); });
    return h.length ? h[h.length - 1].value : null;
  }

  /** Bulk import. rows: [{title, fullName, dob, mobile, deptCode, designation, companyCode, joinDate, vendorCode}] */
  function importRows(user, rows, commit) {
    if (!Array.isArray(rows) || !rows.length) fail('VALIDATION', 'The file has no data rows');
    if (rows.length > 300) fail('VALIDATION', 'Import at most 300 rows at a time');
    var ctx = context(null, true), seen = {}, report = [], okCount = 0;
    rows.forEach(function (row, i) {
      var r = OSC.validateStaff(row, ctx);
      if (r.value.mobile && OSC.isMobile(r.value.mobile)) {
        if (seen[r.value.mobile]) r.errors.mobile = 'Same mobile as row ' + seen[r.value.mobile];
        else seen[r.value.mobile] = i + 2;
      }
      var ok = Object.keys(r.errors).length === 0;
      if (ok) okCount++;
      report.push({ row: i + 2, ok: ok, errors: r.errors, value: r.value });
    });
    var allOk = okCount === rows.length;
    if (!commit || !allOk) return { committed: false, total: rows.length, valid: okCount, invalid: rows.length - okCount, report: report };
    var created = withLock(function () {
      return report.map(function (rep) { return createLocked(user, rep.value, 'Bulk import').staffId; });
    });
    Audit.log(user, 'staff.import', 'Staff', '', 'Imported ' + created.length + ' rows', null, { ids: created });
    return { committed: true, total: rows.length, valid: okCount, invalid: 0, created: created, report: report };
  }

  function stats() {
    var out = { byDept: {}, active: 0, exited: 0, face: {} };
    Db.all('Staff').forEach(function (s) {
      if (s.status === 'Active') {
        out.active++;
        out.byDept[s.deptCode] = (out.byDept[s.deptCode] || 0) + 1;
        out.face[s.faceStatus] = (out.face[s.faceStatus] || 0) + 1;
      } else out.exited++;
    });
    return out;
  }

  return { list: list, get: get, create: create, update: update, transfer: transfer, exit: exit, reactivate: reactivate,
    valueOn: valueOn, importRows: importRows, stats: stats, toPublic: toPublic };
})();


/* ----- 07_api.js ----- */
/* ===== 07 API: web app entry points and router ===== */
/*
 * The console calls: POST <web app URL> with body text JSON {action, token, data}
 * (Content-Type text/plain avoids a CORS preflight, which Apps Script cannot answer).
 * Every reply is JSON: {ok:true, data, serverTime} or {ok:false, error:{code, message, fields}, serverTime}.
 */
var ROUTES = {
  // action: [roles allowed ('*' = no sign-in needed), handler(user, data)]
  'ping': ['*', function () { return { app: APP.name, version: APP.version }; }],
  'auth.login': ['*', function (u, d) { return Auth.login(d.username, d.password, d.userAgent); }],
  'auth.me': ['ANY', function (u) { return { user: { username: u.username, fullName: u.fullName, role: u.role, mustChange: u.mustChange } }; }],
  'auth.logout': ['ANY', function (u) { return Auth.logout(u); }],
  'auth.changePassword': ['ANY', function (u, d) { return Auth.changePassword(u, d.oldPassword, d.newPassword); }],

  'meta.bootstrap': ['APP', function (u) {
    return {
      user: { username: u.username, fullName: u.fullName, role: u.role },
      app: { name: APP.name, version: APP.version, footer: Settings.str('footerText'), orgName: Settings.str('orgName') },
      titles: Settings.list('titles'), designations: Settings.list('designations'),
      departments: Departments.list(), companies: Companies.list(), today: Clock.today(),
      summary: { staff: Staff.stats(), departments: Departments.list(), companies: Companies.list().length }
    };
  }],
  'home.summary': ['APP', function () {
    return { staff: Staff.stats(), departments: Departments.list(), companies: Companies.list().length };
  }],

  'staff.list': ['APP', function (u, d) { return Staff.list(d); }],
  'staff.get': ['APP', function (u, d) { return Staff.get(d.staffId); }],
  'staff.create': ['APP', function (u, d) { return Staff.create(u, d); }],
  'staff.update': ['APP', function (u, d) { return Staff.update(u, d.staffId, d, d.reason); }],
  'staff.transfer': ['APP', function (u, d) { return Staff.transfer(u, d.staffId, d); }],
  'staff.exit': ['APP', function (u, d) { return Staff.exit(u, d.staffId, d); }],
  'staff.reactivate': ['APP', function (u, d) { return Staff.reactivate(u, d.staffId, d); }],
  'staff.import': ['APP', function (u, d) { return Staff.importRows(u, d.rows, !!d.commit); }],

  'companies.list': ['APP', function () { return Companies.list(); }],
  'companies.get': ['APP', function (u, d) { var c = Companies.get(d.companyId); if (!c) fail('NOT_FOUND', 'Company not found'); c.rates = Rates.list(c.companyId); return c; }],
  'companies.save': ['APP', function (u, d) { return Companies.save(u, d, d.reason); }],
  'rates.add': ['APP', function (u, d) { return Rates.add(u, d); }],
  'rates.void': ['APP', function (u, d) { return Rates.voidRate(u, d.rateId, d.reason); }],

  'departments.list': ['APP', function () { return Departments.list(); }],
  'departments.save': ['ADMIN', function (u, d) { return Departments.save(u, d, d.reason); }],

  'users.list': ['ADMIN', function () { return Auth.listUsers(); }],
  'users.create': ['ADMIN', function (u, d) { return Auth.createUser(u, d); }],
  'users.setActive': ['ADMIN', function (u, d) { return Auth.setActive(u, d.username, !!d.active, d.reason); }],
  'users.resetPassword': ['ADMIN', function (u, d) { return Auth.resetPassword(u, d.username, d.reason); }],
  'users.loginLog': ['ADMIN', function (u, d) { return Auth.loginLog(d.limit); }],

  'settings.list': ['ADMIN', function () { return Settings.allForUi(); }],
  'settings.update': ['ADMIN', function (u, d) { return Settings.update(u, d.key, d.value, requireReason(d.reason)); }],

  'audit.recent': ['APP', function (u, d) { return Audit.recent(d.limit, d); }]
};

function handle(body) {
  var req;
  try { req = JSON.parse(body || '{}'); } catch (e) { fail('BAD_REQUEST', 'Request is not valid JSON'); }
  if (!req || typeof req.action !== 'string') fail('BAD_REQUEST', 'Missing action');
  if (req.action === 'batch') return handleBatch(req);
  var route = ROUTES[req.action];
  if (!route) fail('BAD_REQUEST', 'Unknown action ' + req.action);
  var data = req.data && typeof req.data === 'object' ? req.data : {};
  if (route[0] === '*') return route[1](null, data);
  if (route[0] === 'DEVICE') { var dev = Devices.verify(req); return route[1](dev, Devices.payload(req)); }
  return runAs(Auth.check(req.token), req.action, data);
}
/** Runs one console action for a signed-in user (role checks, then the remembered answer if there is one). */
function runAs(user, action, data) {
  var route = ROUTES[action];
  if (!route || route[0] === '*' || route[0] === 'DEVICE') fail('BAD_REQUEST', 'Unknown action ' + action);
  // A user with a temporary password may only change it or sign out.
  if (user.mustChange && ['auth.changePassword', 'auth.logout', 'auth.me'].indexOf(action) < 0)
    fail('MUST_CHANGE_PASSWORD', 'Please set a new password first');
  if (route[0] === 'ADMIN' && user.role !== APP.roles.ADMIN) fail('FORBIDDEN', 'Only the Admin can do this');
  if (route[0] === 'APP' && [APP.roles.ADMIN, APP.roles.OPS].indexOf(user.role) < 0) fail('FORBIDDEN', 'Not allowed');
  if (typeof Speed !== 'undefined' && Speed.cacheable(action)) return Speed.remembered(user, action, data, function () { return route[1](user, data); });
  return route[1](user, data);
}
/** Several console reads in one request (saves Google's start-up time for each). Each item answers on its own. */
function handleBatch(req) {
  var items = Array.isArray(req.items) ? req.items : [];
  if (!items.length || items.length > 15) fail('BAD_REQUEST', 'A batch holds 1 to 15 requests');
  var user = Auth.check(req.token);
  return items.map(function (it) {
    try {
      if (!it || typeof it.action !== 'string' || it.action === 'batch') fail('BAD_REQUEST', 'Missing action');
      return { ok: true, data: runAs(user, it.action, it.data && typeof it.data === 'object' ? it.data : {}) };
    } catch (e) {
      if (e && e.name === 'AppError') return { ok: false, error: { code: e.code, message: e.message, fields: e.fields } };
      console.error(e && e.stack ? e.stack : e);
      return { ok: false, error: { code: 'INTERNAL', message: 'Something went wrong on the server. Please try again; if it repeats, tell the Admin.' } };
    }
  });
}

function respond(obj) {
  obj.serverTime = Clock.now();
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function apiCall(body) {
  if (typeof Speed !== 'undefined') Speed.lastHit = false;
  try {
    return { ok: true, data: handle(body) };
  } catch (e) {
    if (e && e.name === 'AppError') return { ok: false, error: { code: e.code, message: e.message, fields: e.fields } };
    console.error(e && e.stack ? e.stack : e);
    return { ok: false, error: { code: 'INTERNAL', message: 'Something went wrong on the server. Please try again; if it repeats, tell the Admin.' } };
  }
}

function doPost(e) {
  var t0 = Date.now();
  var out = apiCall(e && e.postData ? e.postData.contents : '');
  out.ms = Date.now() - t0; // time our code used; the rest of the wait is Google starting the script
  if (typeof Speed !== 'undefined' && Speed.lastHit) out.cached = true;
  return respond(out);
}
function doGet() { return respond({ ok: true, data: { app: APP.name, version: APP.version, status: 'running' } }); }


/* ----- 08_setup.js ----- */
/* ===== 08 Setup, menu, maintenance and demo data (run from the script editor or the sheet menu) ===== */

/** Adds the "OutSource Connect" menu to the Google Sheet. */
function onOpen() {
  SpreadsheetApp.getUi().createMenu('OutSource Connect')
    .addItem('1. Run setup (safe to repeat)', 'setup')
    .addItem('2. Add demo data (fake)', 'seedDemoData')
    .addItem('3. Remove demo data', 'removeDemoData')
    .addItem('4. Start automatic processing (every 5 min)', 'installTriggers')
    .addItem('5. Recalculate this month\'s duties', 'recalcThisMonth')
    .addItem('6. Send a test email', 'sendTestEmail')
    .addItem('7. Restore from a backup…', 'restoreFromBackup')
    .addSeparator()
    .addItem('Reset Admin password', 'resetAdminPassword')
    .addItem('Check password speed', 'benchmarkHash')
    .addToUi();
}

function showResult_(title, text) {
  console.log(title + '\n' + text);
  try { SpreadsheetApp.getUi().alert(title, text, SpreadsheetApp.getUi().ButtonSet.OK); } catch (e) { /* running without the sheet open */ }
}

/**
 * Creates or upgrades every tab, adds default settings and departments, and creates the first Admin.
 * Safe to run again: nothing existing is deleted or overwritten.
 */
function setup() {
  var book = SpreadsheetApp.getActiveSpreadsheet();
  if (!book) throw new Error('Open the Google Sheet and run setup from Extensions > Apps Script inside it.');
  var props = PropertiesService.getScriptProperties();
  props.setProperty('SPREADSHEET_ID', book.getId());
  book.setSpreadsheetTimeZone(APP.tz);
  Db.reset();

  var report = [];
  Object.keys(SCHEMA).forEach(function (t) {
    var added = Db.ensureTable(t);
    if (added.length) report.push(t + ': ' + added.length + ' column(s) added');
  });
  var blank = book.getSheetByName('Sheet1');
  if (blank && blank.getLastRow() === 0 && book.getSheets().length > 1) book.deleteSheet(blank);

  var now = Clock.now();
  var have = {}; Db.all('Settings').forEach(function (s) { have[s.key] = 1; });
  var newSettings = Object.keys(DEFAULT_SETTINGS).filter(function (k) { return !have[k]; }).map(function (k) {
    return { key: k, value: DEFAULT_SETTINGS[k][0], type: DEFAULT_SETTINGS[k][1], description: DEFAULT_SETTINGS[k][2], updatedAt: now, updatedBy: 'setup' };
  });
  Db.insertMany('Settings', newSettings);
  if (newSettings.length) report.push(newSettings.length + ' setting(s) added');

  if (!Db.all('Departments').length) {
    Db.insertMany('Departments', DEFAULT_DEPARTMENTS.map(function (d) {
      return { code: d.code, name: d.name, active: true, nextSeq: 1, reqDay: d.reqDay, reqNight: d.reqNight, sortOrder: d.sortOrder, updatedAt: now, updatedBy: 'setup' };
    }));
    report.push('Departments HK, SS, SC added');
  }

  // Drive folders for later phases (photos, backups, month packs)
  var rootId = props.getProperty('DRIVE_ROOT_ID'), root = null;
  if (rootId) { try { root = DriveApp.getFolderById(rootId); } catch (e) { root = null; } }
  if (!root) {
    root = DriveApp.createFolder('OutSource Connect Data');
    props.setProperty('DRIVE_ROOT_ID', root.getId());
    ['Photos', 'Unrecognised', 'Backups', 'Month packs'].forEach(function (n) { props.setProperty('DRIVE_' + n.toUpperCase().replace(' ', '_') + '_ID', root.createFolder(n).getId()); });
    report.push('Drive folder "OutSource Connect Data" created');
  }

  var tempPw = null;
  if (!Db.all('Users').length) {
    tempPw = Auth.tempPassword();
    Db.insert('Users', { username: 'admin', fullName: 'System Admin', role: APP.roles.ADMIN, active: true, pwHash: Auth.hashPassword(tempPw), mustChange: true, failedCount: 0, createdAt: now, createdBy: 'setup', updatedAt: now, updatedBy: 'setup' });
    Audit.log(null, 'setup.createAdmin', 'Users', 'admin', 'First setup', null, null);
    report.push('Admin user created');
  }
  if (typeof RuleVersions !== 'undefined' && !Db.all('Rules').length) { RuleVersions.ensureDefault(); report.push('Default attendance rules (RV1) added'); }
  Audit.log(null, 'setup.run', 'System', APP.version, report.join('; '), null, null);
  CACHED_TABLES.forEach(function (t) { Db.invalidate(t); });

  var msg = (report.length ? report.join('\n') : 'Everything was already set up.') +
    (tempPw ? '\n\nAdmin username: admin\nTemporary password: ' + tempPw + '\n\nWrite this down now. You must change it at first sign-in.' : '');
  showResult_('OutSource Connect setup ' + APP.version, msg);
  return msg;
}

/** Emergency: new temporary password for the user "admin" (or the first Admin). Shown once. */
function resetAdminPassword() {
  var u = Db.find('Users', 'admin') || Db.where('Users', function (x) { return x.role === APP.roles.ADMIN; })[0];
  if (!u) throw new Error('No Admin user. Run setup first.');
  var pw = Auth.tempPassword();
  Db.update('Users', u.username, { pwHash: Auth.hashPassword(pw), mustChange: true, failedCount: 0, lockedUntil: '', active: true, updatedAt: Clock.now(), updatedBy: 'script-editor' });
  Auth.revokeAll(u.username);
  Audit.log(null, 'users.resetPassword', 'Users', u.username, 'Reset from script editor', null, null);
  showResult_('Admin password reset', 'Username: ' + u.username + '\nTemporary password: ' + pw + '\n\nChange it at first sign-in.');
}

/** Measures the password check on Google's servers. Sign-in uses one check; the target is well under 1 second. */
function benchmarkHash() {
  var t0 = Date.now(); var h = Auth.hashPassword('benchmark-1234'); var tHash = Date.now() - t0;
  var t1 = Date.now(); Auth.verifyPassword('benchmark-1234', h); var tCheck = Date.now() - t1;
  showResult_('Password speed', 'Sign-in password check: ' + tCheck + ' ms\nCreating a new password: ' + tHash + ' ms\n(' + PBKDF2_ITERATIONS + ' rounds, version ' + APP.version + ')');
  return tCheck;
}

