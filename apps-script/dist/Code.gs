})();

ROUTES['month.status'] = ['APP', function (u, d) { return MonthEnd.status(d.month || OSCBill.prevMonth(Clock.today().slice(0, 7))); }];
ROUTES['month.preview'] = ['APP', function (u, d) { return MonthEnd.preview(d.month, d.deptCode, d.companyId); }];
