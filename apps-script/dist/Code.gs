SCHEMA.Rules = { key: 'ruleId', cols: [['ruleId', 'str'], ['effectiveFrom', 'date'], ['deptCode', 'str'], ['params', 'json'], ['status', 'str'], ['note', 'str'], ['createdAt', 'datetime'], ['createdBy', 'str']] };
