    padded[L - 4] = (bits >>> 24) & 255; padded[L - 3] = (bits >>> 16) & 255; padded[L - 2] = (bits >>> 8) & 255; padded[L - 1] = bits & 255;
    padded[L - 5] = Math.floor(bits / 4294967296) & 255;
